# =====================================================================
#  ShalvarSara — environment template
#  Copy to `.env` (used by docker compose) and keep real values secret.
# =====================================================================

# ---------- Database ----------
POSTGRES_USER=shalvarsara
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=shalvarsara
POSTGRES_PORT=5432

# Connection string used by the Go backend.
# When running the backend inside docker compose, the host is the service name `db`.
DATABASE_URL=postgres://shalvarsara:change-me-in-production@localhost:5432/shalvarsara?sslmode=disable

# ---------- Backend ----------
APP_ENV=development
HTTP_PORT=8080
# Comma separated list of allowed browser origins (CORS).
# Both the hostname and the literal IPv4 address are listed: `localhost` can
# resolve to ::1 first on Windows, and a VPN/proxy client may change which one
# the browser ends up using.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173

# JWT — MUST be replaced with long random values in production.
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-32-chars-min
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please-32-chars-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# First admin account created by the seeder.
ADMIN_NAME=مدیر فروشگاه
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345

# ---------- ZarinPal ----------
# sandbox = true uses the ZarinPal sandbox; set false for production.
# In sandbox any UUID works as the merchant id.
ZARINPAL_SANDBOX=true
ZARINPAL_MERCHANT_ID=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
# Where the gateway sends the browser back to. This must be the API callback:
# it verifies the payment and then redirects to ZARINPAL_RESULT_URL with
# ?order=<id>&status=ok|failed. Both must be reachable from the browser.
ZARINPAL_CALLBACK_URL=http://127.0.0.1:8080/api/v1/payments/callback
# Where the API sends the customer after verifying (frontend result page).
ZARINPAL_RESULT_URL=http://localhost:5173/payment/result

# ---------- Delivery ----------
# Flat fee in Toman below the threshold, and the goods subtotal at or above
# which delivery is free. The server owns these rules; the storefront only
# mirrors them before checkout.
SHIPPING_FLAT_COST=65000
SHIPPING_FREE_FROM=2000000

# ---------- Phone verification (sign-up) ----------
# SMS_TEST_MODE=true means no SMS panel is connected yet: the API returns the
# verification code in the response and the sign-up page shows it to the
# customer with an explanation. Flip it to false once a panel is wired in —
# nothing else in the flow changes.
SMS_TEST_MODE=true
SMS_CODE_TTL=2m
SMS_RESEND_AFTER=60s

# ---------- Frontend ----------
# Injected at build time by Vite (VITE_ prefix is required).
VITE_API_BASE_URL=http://localhost:8080/api/v1
