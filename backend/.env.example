# Backend-only overrides. Usually the root `.env` is enough.
# Copy to `.env` when running the API outside docker compose.

APP_ENV=development
HTTP_PORT=8080
# Comma separated list of allowed browser origins (CORS).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173

DATABASE_URL=postgres://shalvarsara:shalvarsara@localhost:5432/shalvarsara?sslmode=disable

JWT_ACCESS_SECRET=dev-access-secret-change-me-please-32-chars-min
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please-32-chars-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

RUN_MIGRATIONS=true
SEED_ON_START=false

ADMIN_NAME=مدیر فروشگاه
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345

ZARINPAL_SANDBOX=true
ZARINPAL_MERCHANT_ID=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
ZARINPAL_CALLBACK_URL=http://127.0.0.1:8080/api/v1/payments/callback
ZARINPAL_RESULT_URL=http://localhost:5173/payment/result

SHIPPING_FLAT_COST=65000
SHIPPING_FREE_FROM=2000000

# Phone verification for sign-up. SMS_TEST_MODE=true means no SMS panel is
# connected yet: the API returns the code in the response (and the sign-up page
# shows it). Set it to false once a real panel is wired in — nothing else has to
# change. SMS_RESEND_AFTER throttles repeat requests per number.
SMS_TEST_MODE=true
SMS_CODE_TTL=2m
SMS_RESEND_AFTER=60s

# Behind a hosting dashboard/CDN proxy (Chabokan, Render, Arvan, ...) the socket
# peer is the proxy, so every visitor would look like one IP to the rate
# limiter. Turn this on there and leave it off locally.
TRUST_PROXY_HEADER=false
PROXY_HEADER=X-Forwarded-For

