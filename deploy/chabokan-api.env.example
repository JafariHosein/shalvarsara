APP_ENV=production
HTTP_PORT=8080
TRUST_PROXY_HEADER=true
PROXY_HEADER=X-Forwarded-For
CORS_ORIGINS=https://REPLACE-web-domain
DATABASE_URL=postgres://REPLACE-db-user:REPLACE-db-password@REPLACE-db-host:REPLACE-db-port/REPLACE-db-name?sslmode=disable
JWT_ACCESS_SECRET=REPLACE-with-32-random-chars-minimum
JWT_REFRESH_SECRET=REPLACE-with-32-other-random-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
RUN_MIGRATIONS=true
SEED_ON_START=true
ADMIN_NAME=مدیر فروشگاه
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE-with-a-strong-password
ZARINPAL_SANDBOX=true
ZARINPAL_MERCHANT_ID=REPLACE-with-a-sandbox-uuid
ZARINPAL_CALLBACK_URL=https://REPLACE-api-domain/api/v1/payments/callback
ZARINPAL_RESULT_URL=https://REPLACE-web-domain/payment/result
SHIPPING_FLAT_COST=65000
SHIPPING_FREE_FROM=2000000
SMS_TEST_MODE=true
SMS_CODE_TTL=2m
SMS_RESEND_AFTER=60s
